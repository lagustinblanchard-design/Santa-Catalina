NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_SHEETS_ID=your_google_sheets_id_here

# Terreno fotorrealista del showroom 3D (/mapa-3d) — malla de dron subida a Cesium ion.
# Opcional: sin estas dos vars, LotMap3D.tsx se comporta exactamente igual que hoy
# (satélite Esri, sin toggle "Vista real"). Completar cuando exista la captura.
NEXT_PUBLIC_CESIUM_ION_ASSET_ID=
NEXT_PUBLIC_CESIUM_ION_TOKEN=
# Offset de cota (metros) para asentar los lotes sobre la malla real. Ajustar a ojo.
NEXT_PUBLIC_TERRAIN_BASE_ELEV=0

# Widget de chat (/v2) — @botpress/webchat. Client ID del bot en
# Botpress Dashboard > Webchat > Features > Advanced Settings.
# Es público por diseño (viaja al browser); sin esta var, ChatWidgetV2 no renderiza el panel.
NEXT_PUBLIC_BOTPRESS_CLIENT_ID=

# Google Analytics 4 — Measurement ID de https://analytics.google.com (Admin >
# Flujos de datos > tu sitio web > "ID de MEDICIÓN", formato G-XXXXXXX).
# Es público por diseño. Sin esta var, components/Analytics.tsx no carga nada.
# Además sólo se activa tras aceptar el banner de cookies (ver lib/consent.ts).
NEXT_PUBLIC_GA_ID=

# URL final del sitio en producción (con https://, sin barra al final) — la usan
# el sitemap, robots.txt y Open Graph (ver lib/site-url.ts). Sin esta var cae a
# VERCEL_URL (el *.vercel.app del deploy), que también es https pero no es el
# dominio final si ya hay uno custom.
NEXT_PUBLIC_SITE_URL=

# Google Search Console — Agregar propiedad > método "Etiqueta HTML" > pegar
# sólo el valor de content="..." (no la etiqueta completa). Sin esta var no
# se emite la meta tag, no rompe nada.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
