# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

__pycache__
dist
.venv

.vercel

# scratch / tool metadata (disposable, not project code)
.tmp/
.claude/

# material fuente sin derivar — el derivado optimizado que sí se sirve vive
# en public/timeline/ (ver scripts/timeline/build.mjs)
/public/higgsfield-renders/

# sin usar todavía por ningún componente
/public/gallery/timelapse-obra-01.mp4
